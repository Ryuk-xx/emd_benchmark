# Model weights, downloaded per machine into models/ on first run
/models/

# Python
.venv/
__pycache__/
*.pyc

# Corpus and facts exported from Neo4j. These are internal Viettel documents
# (gói cước, công văn, hướng dẫn nội bộ) and stay out of the repo. Move them to
# the embedding machine by hand; see README.
data/

# Embedding matrices: derived data, and embeddings/ada002/corpus_full.npy alone
# is 220 MB, past GitHub's 100 MB per-file hard limit.
embeddings/
embeddings_fact/

# Benchmark output. Regenerated by the scripts, and the CSVs carry full chunk and
# document text from the internal corpus (perf_dataset_long.csv alone is 4.8 MB of it).
results/

# Local secrets
.env
