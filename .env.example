# Neo4j source graph. READ-ONLY: the export scripts use session.execute_read(),
# and the server rejects any write with Neo.ClientError.Statement.AccessMode.
NEO4J_URI=bolt://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<password>

# Used only by build_goldenset.py to write the golden-set questions.
OPENAI_API_KEY=
# OPENAI_BASE_URL=        # set for Azure or a local OpenAI-compatible endpoint
